{
    "name": "synthient/synthient-php",
    "description": "The official PHP client for the Synthient API: IP and domain intelligence, account details, and real-time and bulk data feeds.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "synthient",
        "ip intelligence",
        "proxy detection",
        "vpn detection",
        "threat intelligence"
    ],
    "homepage": "https://github.com/synthient/synthient-php",
    "support": {
        "docs": "https://docs.synthient.com",
        "issues": "https://github.com/synthient/synthient-php/issues",
        "source": "https://github.com/synthient/synthient-php"
    },
    "require": {
        "php": ">=8.3",
        "php-64bit": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1",
        "guzzlehttp/psr7": "^2.13 || ^3.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.3"
    },
    "autoload": {
        "psr-4": {
            "Synthient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Synthient\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "@lint:cs",
            "@lint:phpstan",
            "@lint:phpstan-tests"
        ],
        "lint:cs": "php-cs-fixer check --diff",
        "lint:phpstan": "phpstan analyse --no-progress",
        "lint:phpstan-tests": "phpstan analyse --no-progress --level 6 tests",
        "check-package": "scripts/check-package.sh"
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/composer.lock",
            "/.phpunit.cache",
            "/.php-cs-fixer.cache",
            "*.parquet"
        ]
    }
}
